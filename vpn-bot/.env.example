# Telegram
BOT_TOKEN=123456:ABC-DEF
ADMIN_IDS=123456789,987654321

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vpn_bot
POSTGRES_USER=vpn_bot
POSTGRES_PASSWORD=change_me_strong_password

# Redis
REDIS_URL=redis://redis:6379/0

# Trial & referral
TRIAL_DAYS=3
REFERRAL_BONUS_DAYS=7

# Payment (demo mode — set PAYMENT_PROVIDER=yookassa when ready)
PAYMENT_PROVIDER=demo
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Happ subscription public base (without trailing slash on domain path)
DEFAULT_SUB_PATH=/sub/

# Logging
LOG_LEVEL=INFO

# --- Xray servers (repeat block SERVER_N_* for each node) ---
# Server 1 (primary — local 3X-UI on VPS host)
SERVER_1_NAME=Primary
SERVER_1_PANEL_URL=http://host.docker.internal:2053
SERVER_1_USERNAME=admin
SERVER_1_PASSWORD=XrayAdmin2026!
SERVER_1_INBOUND_ID=1
SERVER_1_SUB_DOMAIN=skolesnikov.site
SERVER_1_SUB_URI=https://skolesnikov.site/sub/
SERVER_1_ENABLED=true

