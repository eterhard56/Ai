# AI Platform Environment Configuration
# Copy to .env and adjust values

# General
APP_NAME=ai-platform
APP_ENV=production
SECRET_KEY=change-me-to-random-64-char-string
DEBUG=false

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_platform
POSTGRES_USER=ai_platform
POSTGRES_PASSWORD=change-me-strong-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen3:8b

# JWT
JWT_SECRET_KEY=change-me-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Yandex Direct API
YANDEX_DIRECT_TOKEN=
YANDEX_DIRECT_CLIENT_LOGIN=

# Yandex Metrika
YANDEX_METRIKA_TOKEN=
YANDEX_METRIKA_COUNTER_ID=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_DAILY_REPORT_HOUR=9

# Parser 2GIS
PARSER_2GIS_URL=http://parser-2gis:8080
PARSER_2GIS_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=/api/v1
FRONTEND_URL=http://localhost:3000

# Nginx
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Backup
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 3 * * *
